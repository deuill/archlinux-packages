# Maintainer: Alex Palaistras <alex+archlinux@deuill.org>
pkgname=deuill-sway
pkgver=1.0.8
pkgrel=1
pkgdesc="Sway-based desktop environment for deuill systems"
arch=("any")
url="https://git.deuill.org/deuill/archlinux-packages"
license=("MIT")
source=(
    "archlinux-packages::git+file://$(realpath ${PWD}/..)"
)
sha1sums=("SKIP")
makedepends=(git)
depends=(
    # Core dependencies.
    greetd
    greetd-tuigreet
    rofi
    sway
    swaybg
    swayidle
    swaylock
    waybar
    xorg-xwayland

    # Terminal applications.
    aerc
    bluetui
    btop
    elinks
    emacs
    impala
    khal
    ncmpcpp
    pulsemixer
    vifm

    # Graphical applications.
    foot
    mpv
    swayimg
    zathura
    zathura-cb
    zathura-pdf-mupdf

    # System daemons.
    dunst
    gammastep
    mpd
    pipewire
    pipewire-alsa
    pipewire-pulse
    vdirsyncer
    wireplumber

    # Secondary utilities and dependencies.
    brightnessctl
    chafa
    cmark
    grim
    libnotify
    mupdf-tools
    pass
    pass-otp
    perl-file-mimeinfo
    python-i3ipc
    ripgrep
    rofi-calc
    slurp
    unrar
    unzip
    wl-clipboard
    xdg-desktop-portal-gtk
    xdg-desktop-portal-wlr
    xdg-user-dirs
    xdg-utils
    xorg-xrdb
    zip

    # Common fonts.
    noto-fonts
    noto-fonts-emoji
    ttf-ibm-plex
    ttf-liberation
    ttf-nerd-fonts-symbols
    ttf-nerd-fonts-symbols-mono

    # Themes.
    materia-gtk-theme
    papirus-icon-theme

    # Additional libraries.
    aspell
    aspell-en
    python-httplib2
    python-pyparsing
)
install="$pkgname.install"

package() {
    cp --recursive "$srcdir/archlinux-packages/$pkgname/files/." "$pkgdir/"
}

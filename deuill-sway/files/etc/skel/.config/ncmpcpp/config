[global]
lyrics_directory             = "~/.cache/mpd/lyrics"
connected_message_on_startup = "no"
main_window_color            = "default"
centered_cursor              = "yes"
enable_window_title          = "yes"
external_editor              = "emacs"

[header]
header_visibility   = "yes"
header_window_color = "default"
volume_color        = "black"
state_line_color    = "black"

[playlist]
playlist_display_mode               = "columns"
titles_visibility                   = "no"
song_list_format                    = "%t $R%a %N"
song_columns_list_format            = "(3f)[]{NE} (8f)[]{lr} (50)[]{t|f:Title} (20)[]{ar} (20)[]{br} (4f)[]{y}"
now_playing_prefix                  = "$b$r"
now_playing_suffix                  = "$/r$/b"
current_item_prefix                 = "$(red)$r"
current_item_suffix                 = "$/r$(end)"
current_item_inactive_column_prefix = "$(black)$r"
current_item_inactive_column_suffix = "$/r$(end)"

[statusbar]
progressbar_look          = "━🞆 "
progressbar_color         = "red"
statusbar_visibility      = "yes"
progressbar_elapsed_color = "red"
statusbar_color           = "black"
song_status_format        = "{%t - %a}"

[library]
song_library_format = "{{%a - %t}|{%f}}{$R%l}"
empty_tag_color     = "red"

[visualizer]
visualizer_data_source = "~/.cache/mpd/mpd.fifo"
visualizer_output_name = "fifo"
visualizer_in_stereo   = "yes"

visualizer_type = "ellipse"
visualizer_look = "●▮"

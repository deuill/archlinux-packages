# Behaviour.
set statusbar-basename  true
set database            sqlite
set selection-clipboard clipboard

# Appearance and theme.
set font                    "Terminus 10"
set guioptions              ""

set default-bg              "#e0dcd7"
set default-fg              "#1d1b19"

set statusbar-bg            "#0a0b08"
set statusbar-fg            "#e0dcd7"

set inputbar-bg             "#0a0b08"
set inputbar-fg             "#e0dcd7"

set notification-bg         "#0a0b08"
set notification-fg         "#e0dcd7"

set notification-error-bg   "#ab4649"
set notification-error-fg   "#e0dcd7"

set notification-warning-bg "#0a0b08"
set notification-warning-fg "#ab4649"

set highlight-color         "rgba(171, 70, 66, 0.5)"
set highlight-active-color  "rgba(171, 70, 66, 0.5)"
set highlight-fg            "#0a0b08"

set completion-bg           "#1d1b19"
set completion-fg           "#e0dcd7"

set completion-highlight-bg "#1d1b19"
set completion-highlight-fg "#e0dcd7"

set index-bg                "#e0dcd7"
set index-fg                "#1d1b19"

set index-active-bg         "#ab4649"
set index-active-fg         "#f7f3ef"

set recolor-lightcolor      "#f7f3ef"
set recolor-darkcolor       "#1d1b19"

set recolor                 "false"
set recolor-keephue         "true"

* {
    background:        #0a0b08;
    foreground:        #e0dcd7;
    normal-background: var(background);
    normal-foreground: var(foreground);
    active-background: var(background);
    active-foreground: var(foreground);
    urgent-background: var(background);
    urgent-foreground: var(foreground);

    alternate-normal-background: var(background);
    alternate-normal-foreground: var(foreground);
    alternate-active-background: var(active-background);
    alternate-active-foreground: var(active-foreground);
    alternate-urgent-background: var(active-background);
    alternate-urgent-foreground: var(urgent-foreground);

    selected-normal-background: #ab4649;
    selected-normal-foreground: var(foreground);
    selected-active-background: var(selected-normal-background);
    selected-active-foreground: var(selected-normal-foreground);
    selected-urgent-background: var(selected-normal-background);
    selected-urgent-foreground: var(selected-normal-foreground);

    background-color: rgba(0, 0, 0, 0%);
    border-color:     var(background);
    separatorcolor:   var(foreground);

    lightbg: #706c68;
    lightfg: #f7f3ef;
    red:     #ab4649;

    spacing: 2;
}

element {
    border-radius: 0;
    border:        0;
    padding:       5px;
}

element normal.normal {
    background-color: var(normal-background);
    text-color:       var(normal-foreground);
}

element normal.urgent {
    background-color: var(urgent-background);
    text-color:       var(urgent-foreground);
}

element normal.active {
    background-color: var(active-background);
    text-color:       var(active-foreground);
}

element selected.normal {
    background-color: var(selected-normal-background);
    text-color:       var(selected-normal-foreground);
}

element selected.urgent {
    background-color: var(selected-urgent-background);
    text-color:       var(selected-urgent-foreground);
}

element selected.active {
    background-color: var(selected-active-background);
    text-color:       var(selected-active-foreground);
}

element alternate.normal {
    background-color: var(alternate-normal-background);
    text-color:       var(alternate-normal-foreground);
}

element alternate.urgent {
    background-color: var(alternate-urgent-background);
    text-color:       var(alternate-urgent-foreground);
}

element alternate.active {
    background-color: var(alternate-active-background);
    text-color:       var(alternate-active-foreground);
}

element-text {
    background-color: none;
    highlight:        inherit;
    text-color:       inherit;
}

element-icon {
    background-color: none;
    padding:          0 5px 0 0;
    size:             1em;
    text-color:       inherit;
}

window {
    background-color: var(background);
    border:           0;
    location:         north;
    width:            100%;
    y-offset:         -25px;
}

mainbox {
    padding: 0;
    border:  0;
}

@media (enabled: env(ROFI_HORIZONTAL, false)) {
    mainbox {
        orientation: horizontal;
    }
}

message {
    padding:      5px;
    border-color: var(separatorcolor);
    border:       0px;
}

textbox {
    text-color: var(foreground);
}

listview {
    border:       0;
    fixed-height: false;
    dynamic:      true;
    layout:       vertical;
    lines:        10;
    padding:      0;
    scrollbar:    false;
    spacing:      5;
}

@media (enabled: env(ROFI_HORIZONTAL, false)) {
    listview {
        layout: horizontal;
    }
}

scrollbar {
    width:        5px;
    padding:      0 0 0 5px;
    handle-width: 5px;
    border:       0;
    handle-color: #ab4649;
}

sidebar {
    border-color: var(separatorcolor);
    border:       2px dash 0px 0px;
}

button {
    spacing:    0;
    text-color: var(normal-foreground);
}

button selected {
    background-color: var(selected-normal-background);
    text-color:       var(selected-normal-foreground);
}

num-filtered-rows {
    expand:     false;
    text-color: var(lightbg);
}

num-rows {
    expand:     false;
    text-color: var(lightbg);
}

textbox-num-sep {
    expand:     false;
    str:        "/";
    text-color: var(lightbg);
}

inputbar {
    children:   [entry, num-filtered-rows, textbox-num-sep, num-rows, case-indicator];
    padding:    3px 7px;
    spacing:    0;
    text-color: var(normal-foreground);
    width:      15%;
}

@media (enabled: env(ROFI_HORIZONTAL, false)) {
    inputbar {
        children:   [entry, case-indicator];
    }
}

case-indicator {
    spacing:    0;
    text-color: var(normal-foreground);
}

entry {
    padding: 0;
    placeholder-color: var(lightbg);
    placeholder: "Type to search…";
    spacing: 0;
    text-color: var(normal-foreground);
}

prompt {
    spacing:    0;
    text-color: var(normal-foreground);
}

textbox-prompt-colon {
    expand:     false;
    margin:     0 0.3em 0 0;
    str:        ":";
    text-color: inherit;
}

mode-switcher {
    border: 0px;
}

#
# name: Deuill Mono
# author: Marid de Uill (https://deuill.org)
# slug: deuill-mono
# slug-underscored: deuill_mono
# variant: light
# is-light-variant: true
#

# Main bg
theme[main_bg]="#e0dcd7"

# Main text color
theme[main_fg]="#1d1b19"

# Title color for boxes
theme[title]="#1d1b19"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ab4649"

# Background color of selected item in processes box
theme[selected_bg]="#ab4649"

# Foreground color of selected item in processes box
theme[selected_fg]="#f7f3ef"

# Color of inactive/disabled text
theme[inactive_fg]="#a9a5a0"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#4e4b47"

# Cpu box outline color
theme[cpu_box]="#706c68"

# Memory/disks box outline color
theme[mem_box]="#706c68"

# Net up/down box outline color
theme[net_box]="#706c68"

# Processes box outline color
theme[proc_box]="#706c68"

# Box divider line and small boxes line color
theme[div_line]="#a9a5a0"

# Temperature graph colors
theme[temp_start]="#706c68"
theme[temp_mid]="#4e4b47"
theme[temp_end]="#2c2b23"

# CPU graph colors
theme[cpu_start]="#706c68"
theme[cpu_mid]="#4e4b47"
theme[cpu_end]="#2c2b23"

# Mem/Disk free meter
theme[free_start]="#706c68"
theme[free_mid]="#4e4b47"
theme[free_end]="#2c2b23"

# Mem/Disk cached meter
theme[cached_start]="#706c68"
theme[cached_mid]="#4e4b47"
theme[cached_end]="#2c2b23"

# Mem/Disk available meter
theme[available_start]="#706c68"
theme[available_mid]="#4e4b47"
theme[available_end]="#2c2b23"

# Mem/Disk used meter
theme[used_start]="#c4c0bb"
theme[used_mid]="#928d88"
theme[used_end]="#2c2b23"

# Download graph colors
theme[download_start]="#c4c0bb"
theme[download_mid]="#928d88"
theme[download_end]="#2c2b23"

# Upload graph colors
theme[upload_start]="#c4c0bb"
theme[upload_mid]="#928d88"
theme[upload_end]="#2c2b23"

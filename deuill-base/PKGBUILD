# Maintainer: Alex Palaistras <alex+archlinux@deuill.org>
pkgname=deuill-base
pkgver=1.0.4
pkgrel=1
pkgdesc="Base system configuration for deuill systems"
arch=("any")
url="https://git.deuill.org/deuill/archlinux-packages"
license=("MIT")
depends=(
    # System daemons.
    bluez
    iwd
    openssh
    pcsclite

    # System utilities and dependencies.
    bluez-utils
    git
    fish
    man-db
    pam-u2f
    ttc-iosevka

    # Other libraries.
    intel-ucode
)
install="$pkgname.install"
source=(
    "mkinitcpio.hooks"
    "systemd-networkd.wired"
    "systemd-networkd.wireless"
    "sudo.wheel"
    "pam-u2f.include"
)
sha1sums=(
    "6c5b2867f848e34d3c31bf5cfb3d72c33ad613d3"
    "10cdc4406049060b761045dbf69f49d1d3c00f2c"
    "edde4cc264dceb662fb1b13e475b161da7d5585f"
    "c005d5b81e05db26b931ecd55f4487868764b61a"
    "6c4c38e53d1c168d6becb24679a83e95cb070dee"
)

package() {
    # Set up hooks for full-disk encryption.
    install -Dm 0644 mkinitcpio.hooks "$pkgdir/etc/mkinitcpio.conf.d/10-hooks.conf"
    # Set up networking.
    install -Dm 0644 systemd-networkd.wired "$pkgdir/etc/systemd/network/20-wired.network"
    install -Dm 0644 systemd-networkd.wireless "$pkgdir/etc/systemd/network/25-wireless.network"
    # Set up default configuration for sudo.
    install -dm 0750 "$pkgdir/etc/sudoers.d"
    install -Dm 0644 sudo.wheel "$pkgdir/etc/sudoers.d/wheel"
    # Set up default configuration for pam-u2f.
    install -dm 0750 "$pkgdir/etc/u2f"
    install -Dm 0644 pam-u2f.include "$pkgdir/etc/pam.d/u2f"
}
